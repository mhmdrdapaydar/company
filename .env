# ==========================================================
#  همکار پلاس — تنظیمات اتصال پایگاه داده SQL
#  توجه: مقادیر زیر «فرضی/نمایشی» هستند و طبق درخواست
#  پروژه، عمداً داخل مخزن گیت ثبت می‌شوند.
#  در محیط واقعی این فایل را از گیت خارج کنید (.gitignore).
# ==========================================================

# درایور: auto | mysql | sqlite
#  auto  → ابتدا MySQL؛ در صورت عدم دسترسی، خودکار روی SQLite بالا می‌آید
DB_DRIVER=auto

# --- مشخصات پایگاه داده MySQL / MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bzhpbuxh_company
DB_USER=bzhpbuxh_company
DB_PASS="fv{W;nYN-B$Rl!1j"

# --- تنظیمات فارسی و نمونه داده ---
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_persian_ci
DB_SEED_DEMO=true

# --- سامانه ---
APP_NAME="همکار پلاس"
APP_TIMEZONE=Asia/Tehran
APP_DEBUG=false

# --- هوش مصنوعی رایگان (اختیاری) ---
AI_PROVIDER=auto
GROQ_API_KEY=
GEMINI_API_KEY=
