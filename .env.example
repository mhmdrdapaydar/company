# نمونه تنظیمات — این فایل را به .env کپی و مقادیر را کامل کنید
DB_DRIVER=auto
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bzhpbuxh_company
DB_USER=bzhpbuxh_company
DB_PASS="رمز-دیتابیس"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_persian_ci
DB_SEED_DEMO=true
APP_NAME="همکار پلاس"
APP_TIMEZONE=Asia/Tehran
APP_DEBUG=false
AI_PROVIDER=auto
# 🔑 کلید رایگان Groq برای تشخیص گفتار فارسی (console.groq.com)
# ⚠️ کلید واقعی را در config/config.local.php بگذارید (در .gitignore است)
#    تا هرگز در گیت ثبت نشود؛ نمونه:
#    define('GROQ_API_KEY', 'gsk_...');
GROQ_API_KEY=
GEMINI_API_KEY=

# پوش پس‌زمینه اختیاری است. بدون آن اعلان داخل برنامه کار می‌کند.
WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_WORKER_TOKEN=

# پوش اندروید اختیاری؛ worker از یک توکن مستقل و کلید سرویس خارج از مخزن استفاده می‌کند.
ANDROID_PUSH_ENABLED=false
ANDROID_PUSH_WORKER_TOKEN=
