# تنظیمات محلی و کلیدهای خصوصی
config/config.local.php

# ⚠️ توجه: در این پروژه فایل .env عمداً در گیت ثبت می‌شود
# (مشخصات پایگاه داده در این نسخه فرضی/نمایشی است).
# اگر این پروژه را در محیط واقعی راه‌اندازی می‌کنید، خط «!.env» را حذف کنید
# تا رمز عبور واقعی وارد مخزن نشود.
.env
!.env

# فایل‌های پایگاه داده محلی و آپلودهای کاربران
storage/database/*.sqlite
storage/database/*.sqlite-*
storage/database/*.db
storage/voices/*
!storage/voices/.gitkeep
storage/attachments/*
!storage/attachments/.gitkeep
storage/sessions/*
!storage/sessions/.gitkeep

# فایل‌های سیستمی و ویرایشگر
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# پوشه تست‌های موقت توسعه
_test/
